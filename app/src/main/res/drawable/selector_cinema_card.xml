<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <stroke android:width="3dp" android:color="#38BDF8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#23304A" />
            <stroke android:width="2dp" android:color="#3B82F6" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#101522" />
            <stroke android:width="1dp" android:color="#24304A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
