<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0284C7" />
            <stroke android:width="3dp" android:color="#FACC15" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#0369A1" />
            <stroke android:width="2dp" android:color="#38BDF8" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1D4ED8" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8C1E293B" />
            <stroke android:width="1dp" android:color="#475569" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
