<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cinema"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Bar (TV Box / Landscape) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/selector_cinema_button"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:text="◀ Voltar"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="14dp"
            android:layout_weight="1"
            android:background="@drawable/selector_cinema_card"
            android:focusable="true"
            android:hint="🔍 Buscar canal ao vivo..."
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_multiview"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/selector_cinema_button"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:text="⊞ Abrir Multi-View"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 3-Column TiviMate-Style Layout: Categories | Channels | Mini-Player + EPG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories"
            android:layout_width="190dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:orientation="vertical" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_channels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="1" />

        <!-- Right Pane: Mini-Player + EPG Timeline -->
        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:background="@drawable/selector_cinema_card"
            android:orientation="vertical"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="195dp"
                android:background="#000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/mini_player_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:use_controller="false" />

                <Button
                    android:id="@+id/btn_fullscreen"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/selector_cinema_button"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="⛶ Tela Cheia"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_epg_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Selecione um canal"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_epg_timeline"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:text="Programação EPG aparecerá aqui."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
