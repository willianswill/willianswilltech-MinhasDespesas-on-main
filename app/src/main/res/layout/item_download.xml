<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/selector_cinema_card"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_dl_poster"
        android:layout_width="54dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_poster_rounded"
        android:clipToOutline="true"
        android:contentDescription="Capa"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_tv_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_dl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Título"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dl_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pronto para assistir offline"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pb_dl_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressTint="@color/accent_cyan" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_dl_play"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/selector_cinema_button"
        android:focusable="true"
        android:paddingHorizontal="12dp"
        android:text="▶ Assistir"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_dl_delete"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/selector_cinema_button"
        android:focusable="true"
        android:paddingHorizontal="10dp"
        android:text="🗑 Excluir"
        android:textColor="@color/accent_danger"
        android:textSize="12sp" />

</LinearLayout>
