<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cinema"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_poster_rounded"
        android:clipToOutline="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_wtv_launcher" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Quem está assistindo?"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_picker_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:text="Cada perfil mantém seu histórico, favoritos e configurações"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_device_mac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/selector_cinema_card"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="📡 MAC do Aparelho: ..."
        android:textColor="@color/accent_cyan"
        android:textSize="14sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_user_profiles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_new_profile"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/selector_cinema_button"
            android:focusable="true"
            android:paddingHorizontal="18dp"
            android:text="+ Novo Perfil"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_manage_mode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/selector_cinema_button"
            android:focusable="true"
            android:paddingHorizontal="18dp"
            android:text="✎ Gerenciar Perfis"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
