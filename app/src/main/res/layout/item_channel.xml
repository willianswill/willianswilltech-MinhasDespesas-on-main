<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/selector_focus_card"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_channel_logo"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="#0B0F19"
        android:contentDescription="Logo do canal"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_tv" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Nome do Canal"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_channel_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Grupo"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_item_fav"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/selector_focus_circle"
        android:contentDescription="Favoritar"
        android:focusable="true"
        android:padding="6dp"
        android:src="@drawable/ic_star_outline" />

</LinearLayout>
