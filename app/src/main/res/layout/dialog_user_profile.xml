<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/et_user_name"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/selector_cinema_card"
        android:focusable="true"
        android:hint="Nome do Perfil (ex: Willians, Kids...)"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_user_pin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/selector_cinema_card"
        android:focusable="true"
        android:hint="PIN de acesso (opcional, 4 dígitos)"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Escolha uma caricatura:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_avatars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
