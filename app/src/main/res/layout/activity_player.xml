<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- Loading / Reconnecting Indicator -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill_dark"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Carregando canal..."
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom Touch + D-Pad OSD Controls Overlay -->
    <RelativeLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:padding="20dp"
        android:visibility="visible">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/selector_focus_circle"
                android:contentDescription="Voltar"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_channel_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Nome do Canal"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_channel_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Categoria"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/selector_focus_circle"
                android:contentDescription="Favoritar"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_star_outline"
                app:tint="#FBBF24" />
        </LinearLayout>

        <!-- Bottom Bar -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <Button
                android:id="@+id/btn_prev_channel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_focus_button"
                android:focusable="true"
                android:minHeight="42dp"
                android:paddingHorizontal="14dp"
                android:text="◀ Anterior"
                android:textColor="#F8FAFC" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/selector_focus_circle"
                android:contentDescription="Play ou Pause"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_pause"
                app:tint="#FFFFFF" />

            <Button
                android:id="@+id/btn_next_channel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_focus_button"
                android:focusable="true"
                android:minHeight="42dp"
                android:paddingHorizontal="14dp"
                android:text="Próximo ▶"
                android:textColor="#F8FAFC" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_aspect_ratio"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_focus_button"
                android:focusable="true"
                android:minHeight="42dp"
                android:paddingHorizontal="14dp"
                android:text="Tela: Ajustar"
                android:textColor="#38BDF8" />

            <Button
                android:id="@+id/btn_reconnect"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_focus_button"
                android:focusable="true"
                android:minHeight="42dp"
                android:paddingHorizontal="14dp"
                android:text="↻ Recarregar"
                android:textColor="#34D399" />
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
