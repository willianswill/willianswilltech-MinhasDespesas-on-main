<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- Loading / Reconnecting Pill -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Carregando..."
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Gesture Feedback Pill (Brilho / Volume / -10s / +10s) -->
    <TextView
        android:id="@+id/tv_gesture_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_player_pill"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:text="🔊 Volume: 80%"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Translucent Side Channel Drawer inside Player -->
    <LinearLayout
        android:id="@+id/channel_drawer"
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#E607090F"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lista Rápida"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close_drawer"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/selector_player_btn"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:text="✕"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_player_channels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Next Episode Floating Button (Series) -->
    <Button
        android:id="@+id/btn_next_episode"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="92dp"
        android:background="@drawable/selector_cinema_button"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:text="▶ Próximo Episódio"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Quick Bottom Panel (DPAD_DOWN: Áudio, Legendas, Episódios) -->
    <LinearLayout
        android:id="@+id/vod_quick_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_player_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_qp_audio"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_player_btn"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:text="🔊 Áudio"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_qp_subtitles"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_player_btn"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:text="💬 Legendas"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_qp_episodes"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_player_btn"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:text="☰ Episódios"
            android:textColor="#38BDF8" />

        <Button
            android:id="@+id/btn_qp_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/selector_player_btn"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:text="✕"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- OSD Controls Overlay -->
    <RelativeLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:padding="20dp"
        android:visibility="visible">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_player_btn"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:text="◀ Voltar"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Título"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Subtítulo / EPG"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_catchup"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/selector_player_btn"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:text="↺ Catch-up"
                android:textColor="#FBBF24"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_multiview"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/selector_player_btn"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:text="⊞ Multi-View"
                android:textColor="#38BDF8" />

            <Button
                android:id="@+id/btn_pip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_player_btn"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:text="❐ PiP"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Bottom Bar -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_player_pill"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <!-- Recent Live Channels Quick Switch (4 Miniaturas) -->
            <LinearLayout
                android:id="@+id/recent_live_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="Últimos canais:"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="3dp">

                        <LinearLayout
                            android:id="@+id/card_recent_live_1"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/selector_player_btn"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_recent_live_1"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginEnd="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_tv_logo" />

                            <TextView
                                android:id="@+id/tv_recent_live_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:maxWidth="145dp"
                                android:text="Canal 1"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/card_recent_live_2"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/selector_player_btn"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_recent_live_2"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginEnd="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_tv_logo" />

                            <TextView
                                android:id="@+id/tv_recent_live_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:maxWidth="145dp"
                                android:text="Canal 2"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/card_recent_live_3"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/selector_player_btn"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_recent_live_3"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginEnd="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_tv_logo" />

                            <TextView
                                android:id="@+id/tv_recent_live_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:maxWidth="145dp"
                                android:text="Canal 3"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/card_recent_live_4"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/selector_player_btn"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_recent_live_4"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginEnd="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_tv_logo" />

                            <TextView
                                android:id="@+id/tv_recent_live_4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:maxWidth="145dp"
                                android:text="Canal 4"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- VOD SeekBar Row -->
            <LinearLayout
                android:id="@+id/seek_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_pos_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:paddingVertical="6dp"
                    android:progressBackgroundTint="#334155"
                    android:progressTint="#38BDF8"
                    android:secondaryProgressTint="#64748B"
                    android:thumbTint="#38BDF8" />

                <TextView
                    android:id="@+id/tv_dur_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-00:00"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_buffer_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Buffer: 0%"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_prev"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="⏮ Ant."
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_play_pause"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:text="⏸ Pausar"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_next"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="Próx. ⏭"
                    android:textColor="#FFFFFF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_channel_list"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="☰ Lista"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_quality"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="⚡ Auto"
                    android:textColor="#FBBF24"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_tracks"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="♫ Áudio/Leg."
                    android:textColor="#F8FAFC" />

                <Button
                    android:id="@+id/btn_aspect"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="Ajustar"
                    android:textColor="#38BDF8" />

                <Button
                    android:id="@+id/btn_reload"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:text="↻"
                    android:textColor="#34D399" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
