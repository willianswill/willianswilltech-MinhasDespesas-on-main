<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- Loading / Reconnecting Pill -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Carregando..."
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- OSD Controls Overlay -->
    <RelativeLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:padding="20dp"
        android:visibility="visible">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_player_btn"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:text="◀ Voltar"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Título"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Subtítulo / EPG"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_catchup"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/selector_player_btn"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:text="↺ Catch-up"
                android:textColor="#FBBF24"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_multiview"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/selector_player_btn"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:text="⊞ Multi-View"
                android:textColor="#38BDF8" />

            <Button
                android:id="@+id/btn_pip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_player_btn"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:text="❐ PiP"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Bottom Bar -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_player_pill"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <!-- VOD SeekBar Row -->
            <LinearLayout
                android:id="@+id/seek_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_pos_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:progressTint="#38BDF8"
                    android:thumbTint="#38BDF8" />

                <TextView
                    android:id="@+id/tv_dur_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_prev"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="⏮ Ant."
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_play_pause"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:text="⏸ Pausar"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_next"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="Próx. ⏭"
                    android:textColor="#FFFFFF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_quality"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="⚡ Auto"
                    android:textColor="#FBBF24"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_tracks"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="♫ Áudio/Leg."
                    android:textColor="#F8FAFC" />

                <Button
                    android:id="@+id/btn_aspect"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:text="Ajustar"
                    android:textColor="#38BDF8" />

                <Button
                    android:id="@+id/btn_reload"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/selector_player_btn"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:text="↻"
                    android:textColor="#34D399" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
